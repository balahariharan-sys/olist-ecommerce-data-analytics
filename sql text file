--##1.What is the total order-item value, including freight?
SELECT ROUND(SUM(price + freight_value)::numeric, 2) AS total_revenue FROM order_items;
--##2.How many unique orders exist in the dataset?
SELECT COUNT(DISTINCT order_id) AS total_orders FROM orders;
--##3.How many unique customers are represented in the dataset?
SELECT COUNT(DISTINCT customer_unique_id) AS total_customers FROM customers;
--##4.What is the average order-item value, including freight, per order?
SELECT ROUND(SUM(oi.price + oi.freight_value)::numeric/ NULLIF(COUNT(DISTINCT o.order_id), 0),2) AS average_order_value
FROM orders o JOIN order_items oi ON o.order_id = oi.order_id;
--##5.How many orders are delivered, canceled, shipped, processing, and in other statuses?
SELECT
    order_status,
    COUNT(*) AS total_orders
FROM orders
GROUP BY order_status
ORDER BY total_orders DESC;
--##6.Which product categories generate the most revenue?
SELECT
    p.product_category_name,
    ROUND(SUM(oi.price + oi.freight_value)::numeric, 2) AS total_revenue
FROM order_items oi
JOIN products p
    ON oi.product_id = p.product_id
GROUP BY p.product_category_name
ORDER BY total_revenue DESC
LIMIT 10;
--##7.Which Brazilian states generate the most order-item revenue?
SELECT
    c.customer_state,
    ROUND(SUM(oi.price + oi.freight_value)::numeric, 2) AS total_revenue
FROM customers c
JOIN orders o
    ON c.customer_id = o.customer_id
JOIN order_items oi
    ON o.order_id = oi.order_id
GROUP BY c.customer_state
ORDER BY total_revenue DESC
LIMIT 10;
--##8.Which products have the highest sales volume?
SELECT
    oi.product_id,
    COUNT(*) AS units_sold
FROM order_items oi
GROUP BY oi.product_id
ORDER BY units_sold DESC
LIMIT 10;
--##9.How does order-item revenue change over time?
SELECT
    DATE_TRUNC('month', o.order_purchase_timestamp) AS order_month,
    ROUND(SUM(oi.price + oi.freight_value)::numeric, 2) AS monthly_revenue
FROM orders o
JOIN order_items oi
    ON o.order_id = oi.order_id
GROUP BY DATE_TRUNC('month', o.order_purchase_timestamp)
ORDER BY order_month;
--##10.Which sellers generate the highest order-item revenue?
SELECT
    oi.seller_id,
    ROUND(SUM(oi.price + oi.freight_value)::numeric, 2) AS total_revenue,
    COUNT(DISTINCT oi.order_id) AS total_orders
FROM order_items oi
GROUP BY oi.seller_id
ORDER BY total_revenue DESC
LIMIT 10;
